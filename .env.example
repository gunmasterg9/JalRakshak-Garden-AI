# JalRakshak Garden AI — Configuration
# Copy this file to .env and edit as needed.

# Ollama local AI settings
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_TIMEOUT=90

# Database (SQLite path, relative to backend/)
JALRAKSHAK_DB=data/jalrakshak.db

# Backend server
HOST=127.0.0.1
PORT=8000

# Upload limits
MAX_IMAGE_SIZE_MB=7
